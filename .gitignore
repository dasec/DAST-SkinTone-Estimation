# Local machine configuration.
configs/paths.yaml

# Everything the pipeline writes: tables, checkpoints, predictions, reports.
runs/
*.pth
*.pt
*.onnx
*.csv

# Images and figures, wherever the pipeline writes them.
*.png
*.jpg
*.jpeg
*.pdf

# Exceptions: the demo images and the figures shown in the README are tracked.
!demo_data/*.jpg
!figures/*.png
!figures/*.jpg
!figures/*.pdf

# Released weights are downloaded into models/ and never committed.
models/*
!models/.gitkeep

__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
.DS_Store
